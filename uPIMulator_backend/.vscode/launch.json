    "version": "0.2.0",
    "configurations": [
        {
            "name": "uPIMulator Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/uPIMulator",
            "args": [
                "--bindir","/home/krakos/niwe/Faho_Sim/uPIMulator_frontend/bin/16_dpus/",
                "--num_tasklets", "16",
                "--benchmark", "KERNEL",
                "--logdir", ".",
                "--num_dpus", "1",

            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build uPIMulator",
            "miDebuggerPath": "/usr/bin/gdb",
            "console": "integratedTerminal"
        },
        {
            "name": "uPIMulator >txt",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/src/uPIMulator",
            "args": [
                "--bindir","/home/krakos/niwe/Faho_Sim/uPIMulator_frontend/bin/16_dpus/",
                "--num_tasklets", "16",
                "--benchmark", "KERNEL",
                "--logdir", ".",
                "--num_dpus", "1",
                ">","t.txt",
             
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build uPIMulator",
            "miDebuggerPath": "/usr/bin/gdb",
            "console": "integratedTerminal"
        },

    ]
}