{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure uPIMulator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-S", "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "detail": "Configure the CMake project"
        },
        {
            "label": "Build uPIMulator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "-j", "$(nproc)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "Configure uPIMulator",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build the uPIMulator project"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "build"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "detail": "Remove the build directory"
        },
        {
            "label": "Rebuild uPIMulator",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Build",
                "Build uPIMulator"
            ],
            "group": "build",
            "detail": "Clean and rebuild"
        },
        
    ]
}