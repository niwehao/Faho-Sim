    "version": "0.2.0",
    "configurations": [
        {
             "name": "Debug Kernel",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--mode", "compile_by_toolchain",
                "--num_tasklets", "4",
                "--benchmark", "KERNEL",
                "--num_dpus", "16"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
             "name": "Debug VA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--mode", "compile_by_toolchain",
                "--num_tasklets", "16",
                "--benchmark", "VA",
                "--num_dpus", "16"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}